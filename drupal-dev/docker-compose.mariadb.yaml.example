#ddev-generated
# A second database container for running tests on MariaDB with
# `ddev phpunit --db=mariadb` when the project database is MySQL.
#
# To use it, copy it next to the other compose files without this file's
# generated marker, set the image tag to the MariaDB version you want to test,
# and restart:
#
#   sed '/^#ddev-generated$/d' .ddev/drupal-dev/docker-compose.mariadb.yaml.example > .ddev/docker-compose.mariadb.yaml
#   ddev restart
#
# Drupal 11 needs at least MariaDB 10.6, Drupal 12 at least 10.11. The volume
# only holds test data. A newer image upgrades it on start, but an older one
# cannot read it, so before you switch to an older version run `ddev stop` and
# `docker volume rm ddev-<project>_mariadb-data`.
services:
  mariadb:
    container_name: ddev-${DDEV_SITENAME}-mariadb
    image: mariadb:10.11
    restart: "no"
    labels:
      com.ddev.site-name: ${DDEV_SITENAME}
      com.ddev.approot: ${DDEV_APPROOT}
    environment:
      - MARIADB_USER=db
      - MARIADB_PASSWORD=db
      - MARIADB_DATABASE=db
      - MARIADB_ROOT_PASSWORD=root
      - MARIADB_AUTO_UPGRADE=1
    expose:
      - "3306"
    volumes:
      - mariadb-data:/var/lib/mysql
    # Lets `ddev start` wait until the server accepts connections.
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5

volumes:
  mariadb-data:
