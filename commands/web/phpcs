#!/usr/bin/env bash

#ddev-generated
## Description: Run PHP CodeSniffer with the coding standard of the project being checked
## Usage: phpcs [flags] [paths]
## Example: "ddev phpcs core/modules/node", "ddev phpcs modules/contrib/token" or "ddev phpcs" for the whole codebase
## ExecRaw: true

# ExecRaw keeps the arguments as they came in; without it ddev joins them and a
# shell in the container splits them again, turning a path with a space into two.

. /mnt/ddev_config/drupal-dev/web-command-helpers.sh || exit 1

core="${DDEV_DOCROOT:+$DDEV_DOCROOT/}core"

phpcs=(vendor/bin/phpcs -ps --parallel="$(nproc)")

phpcs_config() {
  local config
  # The same file names in the same order PHP CodeSniffer looks for itself.
  config=$(config_for "$1" .phpcs.xml phpcs.xml .phpcs.xml.dist phpcs.xml.dist)

  # Core's standard is the fallback for paths that belong to no project with a
  # standard of its own.
  echo "${config:-$core/phpcs.xml.dist}"
}

# PHP CodeSniffer takes paths, not globs, so expand any glob that came in
# whole before working out which project the paths belong to.
expand_globs "$@"
set -- "${ARGS[@]}"

# PHP CodeSniffer options carry their value after an "=", apart from -d.
split_args "-d" "$@"

# A run without paths is the whole codebase, which core's standard already lists
# the files for.
if [ "${#PATHS[@]}" -eq 0 ]; then
  exec "${phpcs[@]}" --standard="$core/phpcs.xml.dist" "$@"
fi

# The paths can belong to several projects, so run each standard in turn and
# fail if any of the runs does.
group_paths phpcs_config
status=0
for config in "${CONFIGS[@]}"; do
  # One project, so hand the arguments over the way they came in.
  if [ "${#CONFIGS[@]}" -eq 1 ]; then
    exec "${phpcs[@]}" --standard="$config" "$@"
  fi

  echo "Checking with $config"
  mapfile -t group < <(paths_of "$config")
  "${phpcs[@]}" --standard="$config" "${FLAGS[@]}" "${group[@]}" || status=$?
done

exit $status
