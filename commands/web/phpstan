#!/usr/bin/env bash

#ddev-generated
## Description: Run PHPStan with the configuration of the project being analysed
## Usage: phpstan [flags] [paths]
## Example: "ddev phpstan core/modules/node", "ddev phpstan modules/contrib/token" or "ddev phpstan" for the full analysis
## ExecRaw: true

# ExecRaw keeps the arguments as they came in; without it ddev joins them and a
# shell in the container splits them again, turning a path with a space into two.

. /mnt/ddev_config/drupal-dev/web-command-helpers.sh || exit 1

core="${DDEV_DOCROOT:+$DDEV_DOCROOT/}core"

# The default configuration contrib CI uses for a project without one of its own.
contrib_default=/mnt/ddev_config/drupal-dev/phpstan.contrib.neon

# PHPStan reads config.platform from the composer file that $COMPOSER points at,
# which is the overlay. Point it at core's composer.json so it analyses against
# the PHP version core declares instead of the container's runtime version.
export COMPOSER=composer.json

phpstan=(php -d apc.enabled=0 -d apc.enable_cli=0 vendor/bin/phpstan analyze)

# Echoes the configuration that covers a path and the contrib project the path
# belongs to, as one key. Contrib CI adds settings from each project's
# .gitlab-ci.yml, so contrib projects need telling apart even when they share a
# configuration.
phpstan_config() {
  local config project
  config=$(config_for "$1" phpstan.neon phpstan.neon.dist phpstan.dist.neon)
  project=$(contrib_project "$1")

  # A contrib project without a configuration of its own gets the default
  # configuration contrib CI uses for it.
  if [ -z "$config" ] && [ -n "$project" ]; then
    config="$contrib_default"
  fi

  # Core's configuration covers more than the core directory and its baseline
  # only applies cleanly to whole-codebase runs, so use the partial one core
  # ships for exactly this. It is also the fallback for everything else.
  if [ -z "$config" ] || [ "$config" = "$core/phpstan.neon.dist" ]; then
    config="$core/phpstan-partial.neon"
  fi
  echo "$config|$project"
}

# Echoes the default configuration contrib CI uses, filled in for a project. CI
# replaces the placeholder in it with the project's baseline, which
# _PHPSTAN_BASELINE_FILENAME names. A project without a baseline gets none. The
# file keeps its name from one run to the next, so PHPStan's result cache stays
# valid.
contrib_config() {
  local project="$1" baseline file
  baseline=$(ci_variable "$project" _PHPSTAN_BASELINE_FILENAME)
  baseline="$project/${baseline:-phpstan-baseline.neon}"
  file="${TMPDIR:-/tmp}/drupal-dev-phpstan/${project//\//_}.neon"
  mkdir -p "${file%/*}"
  if [ -f "$baseline" ]; then
    sed "s#BASELINE_PLACEHOLDER#$(realpath "$baseline")#" "$contrib_default" > "$file"
  else
    sed "/BASELINE_PLACEHOLDER/d" "$contrib_default" > "$file"
  fi
  echo "$file"
}

# PHPStan takes paths, not globs, so expand any glob that came in whole
# before working out which project the paths belong to.
expand_globs "$@"
set -- "${ARGS[@]}"

split_args "-a|-b|-c|-l|--autoload-file|--configuration|--error-format|--generate-baseline|--instead-of|--level|--memory-limit|--tmp-file" "$@"

# A run without paths is the whole codebase, which is what core's full
# configuration and its baseline are for.
if [ "${#PATHS[@]}" -eq 0 ]; then
  exec "${phpstan[@]}" --configuration="$core/phpstan.neon.dist" "$@"
fi

# The paths can belong to several projects, so run each configuration in turn
# and fail if any of the runs does.
group_paths phpstan_config
status=0
for key in "${CONFIGS[@]}"; do
  config="${key%%|*}"
  project="${key#*|}"

  # Contrib CI runs at the level _PHPSTAN_LEVEL names, whatever the
  # configuration says.
  run_config="$config"
  level=()
  added=""
  if [ -n "$project" ]; then
    [ "$config" = "$contrib_default" ] && run_config=$(contrib_config "$project")
    value=$(ci_variable "$project" _PHPSTAN_LEVEL)
    if [ -n "$value" ]; then
      level=(--level="$value")
      added=" at level $value"
    fi
  fi

  # One project, so hand the arguments over the way they came in. A level given
  # on the command line comes after the one from CI, so it wins.
  if [ "${#CONFIGS[@]}" -eq 1 ]; then
    exec "${phpstan[@]}" --configuration="$run_config" "${level[@]}" "$@"
  fi

  [ -z "$project" ] && echo "Analysing with $config" || echo "Analysing $project with $config$added"
  mapfile -t group < <(paths_of "$key")
  "${phpstan[@]}" --configuration="$run_config" "${level[@]}" "${FLAGS[@]}" "${group[@]}" || status=$?
done

exit $status
