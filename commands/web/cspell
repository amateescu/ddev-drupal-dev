#!/usr/bin/env bash

#ddev-generated
## Description: Run cspell with the configuration of the project being checked
## Usage: cspell [flags] [globs]
## Example: "ddev cspell core/modules/node/**", "ddev cspell modules/contrib/token/**" or "ddev cspell" for the current directory
## ExecRaw: true
## HostWorkingDir: true

# ExecRaw keeps the arguments as they came in; without it ddev joins them and a
# shell in the container splits them again, turning a path with a space into two.
# HostWorkingDir runs the command in the directory it was started from on the
# host, so globs are relative to that directory.

. /mnt/ddev_config/drupal-dev/web-command-helpers.sh || exit 1

root="$DDEV_APPROOT/${DDEV_DOCROOT:+$DDEV_DOCROOT/}"
core="${root}core"

if [ ! -x "$core/node_modules/.bin/cspell" ]; then
  echo "cspell is not installed. Install core's node dependencies first:" >&2
  echo "  ddev exec 'corepack enable && cd ${core#"$DDEV_APPROOT/"} && yarn install'" >&2
  exit 1
fi

# The current directory is the cspell root, so globs are relative to it, the same
# as the paths the other code quality commands take.
cspell=("$core/node_modules/.bin/cspell" --root .)

# Core's check is the big one, so it keeps a cache. The cache belongs to core's
# own configuration, so runs with any other configuration go without.
core_cache=(--cache --cache-location "$core/.cspellcache")

# The default configuration contrib CI uses for a project without one of its own.
contrib_default=/mnt/ddev_config/drupal-dev/cspell.contrib.json

# Echoes the configuration that covers a path and the contrib project the path
# belongs to, as one key. Contrib CI adds words from each project to the
# configuration, so contrib projects need telling apart even when they share one.
cspell_project() {
  local config project
  config=$(config_for "$1" .cspell.json cspell.json .cSpell.json cspell.config.js cspell.config.cjs cspell.config.json cspell.config.yaml cspell.config.yml cspell.yaml cspell.yml)
  project=$(contrib_project "$1")

  # A contrib project without a configuration of its own gets the default
  # configuration contrib CI uses for it. Core's is the fallback for everything
  # else.
  if [ -z "$config" ] && [ -n "$project" ]; then
    config="$contrib_default"
  fi
  echo "${config:-$core/.cspell.json}|$project"
}

# Echoes a configuration for a contrib project, layered on top of the
# configuration given. It adds what contrib CI adds to every project's
# configuration in scripts/prepare-cspell.php of gitlab_templates:
# - the words from _CSPELL_WORDS, the module names and a fixed list of words
# - the flagged words from _CSPELL_FLAGWORDS
# - the paths from _CSPELL_IGNORE_PATHS, the directories and files CI creates,
#   and files that are not the project's own text, such as composer.json,
#   unless _CSPELL_IGNORE_STANDARD_FILES is 0
# - core's dictionaries and the project dictionary that _CSPELL_DICTIONARY names
contrib_config() {
  local config="$1" project="$2" words flagwords ignore standard dictionary dir names found definition file
  local -a prune=() definitions=()

  # CI drops the spaces and the quotes around each word, but leaves the
  # apostrophes inside words alone. The commas put around the list let the first
  # and the last word lose their quotes the same way the ones between them do.
  words=$(ci_variable "$project" _CSPELL_WORDS | tr -d '" ')
  [ -z "$words" ] || words=$(printf ',%s,' "$words" | sed -e "s/,'/,/g" -e "s/',/,/g")
  flagwords=$(ci_variable "$project" _CSPELL_FLAGWORDS | tr -d "\"' ")
  ignore=$(ci_variable "$project" _CSPELL_IGNORE_PATHS | tr -d "\"' ")
  standard=$(ci_variable "$project" _CSPELL_IGNORE_STANDARD_FILES)
  dictionary=$(ci_variable "$project" _CSPELL_DICTIONARY)
  dictionary="$project/${dictionary:-.cspell-project-words.txt}"

  # CI skips the same directories when it looks through the project's files.
  for dir in web vendor node_modules .git recipes; do
    prune+=(-path "$project/$dir" -prune -o)
  done

  # Module names count as words: the project name up to the first "-", and the
  # name of each .info.yml file, split at the underscores.
  names=$({
    basename "$project" | cut -d- -f1
    find "$project" "${prune[@]}" -name '*.info.yml' -printf '%f\n' | sed 's/\.info\.yml$//'
  } | tr _ '\n')

  # Licence, changelog and composer files are not checked. CI finds them by the
  # part of the file name before the first dot, in any case.
  found=$(find "$project" "${prune[@]}" -type f -regextype posix-extended \
    -iregex '.*/(license|copyright|maintainers|changelog|composer)\.[^/]*' -printf '%P\n')

  # Dictionary files that don't exist are left out, the same as in CI.
  for definition in "drupal=$core/misc/cspell/drupal-dictionary.txt" "dictionary=$core/misc/cspell/dictionary.txt" "project-words=$dictionary"; do
    [ -f "${definition#*=}" ] && definitions+=("${definition%%=*}=$(realpath "${definition#*=}")")
  done

  file=$(mktemp -t cspell-XXXXXX.json)
  jq -n --arg config "$(realpath "$config")" --arg project "$(realpath "$project")" \
    --arg words "$words" --arg names "$names" --arg flagwords "$flagwords" \
    --arg ignore "$ignore" --arg standard "$standard" --arg found "$found" \
    --arg definitions "$(printf '%s\n' "${definitions[@]}")" \
    'def list($separator): split($separator) | map(select(length > 0));
     ($definitions | list("\n") | map(capture("^(?<name>[^=]+)=(?<path>.*)$"))) as $definitions
     | {
       import: [$config],
       globRoot: $project,
       words: (($words | list(",")) + ($names | list("\n")) + [
         "lando", "ddev",
         "endapply", "nightwatchjs", "testgroup", "testgroups", "backlinks", "mdhash", "uploaders", "vocabs",
         "curlopt", "returntransfer", "curle", "customrequest", "failonerror", "postfields", "followlocation",
         "colourdefinitionsniff", "seletorsingleline", "teamplatespacingaftercomment", "tforvalue",
         "trhowscommentindentation", "unecessaryfiledeclaration",
         "blocklisted",
         "flagwords", "mkdocs", "autorun", "runtests"
       ] | unique),
       flagWords: ($flagwords | list(",")),
       ignorePaths: ([
         "web", "vendor", "node_modules", ".git", "recipes",
         "*.patch", "*.svg", "*_ignore_*", "build.env", "get-file-via-curl.sh",
         "_cspell_unrecognized_words.txt", "_cspell_updated_project_words.txt"
       ]
       + if $standard == "0" then []
         else ["**/.*.json", "package.json", "yarn.lock", "phpstan*", ".*ignore"] + ($found | list("\n"))
         end
       + ($ignore | list(","))),
       dictionaryDefinitions: $definitions,
       dictionaries: ([
         "companies", "fonts", "html", "php", "softwareTerms", "misc", "typescript", "node",
         "css", "bash", "filetypes", "npm", "lorem-ipsum", "sql", "fullstack"
       ] + ($definitions | map(.name)))
     }' > "$file"
  echo "$file"
}

split_args "-c|-e|-r|--cache-location|--cache-strategy|--config|--dictionary|--disable-dictionary|--exclude|--file-list|--gitignore-root|--issue-template|--language-id|--locale|--report|--reporter|--root|--stop-config-search-at" "$@"

# A file list names the files itself, so it gets no globs added. Otherwise a run
# without globs checks the directory it was started from. From the project root
# that is core, over the same globs core checks in CI.
if [ "${#PATHS[@]}" -eq 0 ]; then
  globs=("$core/**/*" "${root}composer/**/*" "${root}composer.json" "${root}.gitlab-ci/*" "${root}.gitlab-ci.yml")
  [ "$OPERANDS" -eq 0 ] || globs=()
  case " ${FLAGS[*]} " in *" --file-list"*) globs=() ;; esac
  if [ "${#globs[@]}" -eq 0 ] || at_project_root; then
    exec "${cspell[@]}" -c "$core/.cspell.json" "${core_cache[@]}" "$@" "${globs[@]}"
  fi
  # The path goes first, so an option at the end that takes an optional value
  # does not take the path for its value.
  set -- . "$@"
  PATHS=(.)
fi

generated=()
trap 'rm -f "${generated[@]}"' EXIT

# The globs can belong to several projects, so check each project in turn and
# fail if any of the checks does.
group_paths cspell_project
status=0
for key in "${CONFIGS[@]}"; do
  config="${key%%|*}"
  project="${key#*|}"

  cache=()
  if [ -n "$project" ]; then
    run_config=$(contrib_config "$config" "$project")
    generated+=("$run_config")
  else
    run_config="$config"
    [ "$config" = "$core/.cspell.json" ] && cache=("${core_cache[@]}")
  fi

  # One project, so hand the arguments over the way they came in. Otherwise name
  # the project too, because several of them can share the default configuration.
  if [ "${#CONFIGS[@]}" -eq 1 ]; then
    args=("$@")
  else
    [ -z "$project" ] && echo "Checking with $(shown_path "$config")" || echo "Checking $(shown_path "$project") with $(shown_path "$config"), plus what contrib CI adds"
    mapfile -t group < <(paths_of "$key")
    args=("${FLAGS[@]}" "${group[@]}")
  fi

  "${cspell[@]}" -c "$run_config" "${cache[@]}" "${args[@]}" || status=$?
done

exit $status
