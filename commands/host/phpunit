#!/usr/bin/env bash

#ddev-generated
## Description: Run PHPUnit tests
## Usage: phpunit [--db=mysql|mariadb|sqlite|pgsql] [phpunit-args]
## Example: "ddev phpunit core/modules/field" or "ddev phpunit --db=sqlite core/modules/node"

set -e

# Git Bash on Windows rewrites arguments that look like absolute paths before
# they reach ddev, so /var/www/html would turn into a path under the Git install
# directory. The container paths below must reach ddev as they are. Other shells
# ignore this variable.
export MSYS_NO_PATHCONV=1

# Parse our flags, pass everything else through to PHPUnit.
args=()
for arg in "$@"; do
  case "$arg" in
    --db=*) DB="${arg#--db=}" ;;
    *) args+=("$arg") ;;
  esac
done

if [ -n "$DB" ]; then
  case "$DB" in
    mysql)   SIMPLETEST_DB="mysql://db:db@db/db" ;;
    sqlite)  SIMPLETEST_DB="sqlite://localhost/sites/default/files/db.sqlite" ;;
    pgsql)
      if [ "$DDEV_DATABASE_FAMILY" = "postgres" ]; then
        SIMPLETEST_DB="pgsql://db:db@db/db"
      elif ddev exec --raw -- php -r "new PDO('pgsql:host=postgres;dbname=db', 'db', 'db');" >/dev/null 2>&1; then
        SIMPLETEST_DB="pgsql://db:db@postgres/db"
      else
        echo "Error: PostgreSQL is not available. Configure your project with"
        echo "postgres or add a separate postgres container."
        exit 1
      fi
      ;;
    mariadb)
      # DDEV_DATABASE_FAMILY is "mysql" for MariaDB too, so check the type.
      # The container is addressed by its project-scoped name because the bare
      # service name also resolves to other projects' containers over the
      # shared ddev_default network.
      mariadb_host="ddev-${DDEV_SITENAME}-mariadb"
      if [[ "$DDEV_DATABASE" == mariadb:* ]]; then
        SIMPLETEST_DB="mysql://db:db@db/db"
      elif ddev exec --raw -- php -r "new PDO('mysql:host=${mariadb_host};dbname=db', 'db', 'db');" >/dev/null 2>&1; then
        SIMPLETEST_DB="mysql://db:db@${mariadb_host}/db"
      else
        echo "Error: MariaDB is not available. Configure your project with"
        echo "mariadb or add a separate mariadb container, see"
        echo ".ddev/drupal-dev/docker-compose.mariadb.yaml.example."
        exit 1
      fi
      ;;
    *)
      echo "Error: Unknown database type '$DB'. Use mysql, mariadb, sqlite, or pgsql."
      exit 1
      ;;
  esac
  echo "Using database: $DB"
fi

# Clear stale webdriver sessions if Chrome is running. The script goes in over
# stdin, which 'ddev exec --raw' does not forward, so this stays a plain exec.
ddev exec -- bash >/dev/null 2>&1 << 'SCRIPT' || true
  [ -z "${DRUPAL_TEST_WEBDRIVER_HOSTNAME:-}" ] && exit 0
  base_url="http://${DRUPAL_TEST_WEBDRIVER_HOSTNAME}:${DRUPAL_TEST_WEBDRIVER_PORT}"
  curl -f -s "${base_url}/status" 2>/dev/null \
    | jq -r '.value.nodes[].slots[].session.sessionId // empty' 2>/dev/null \
    | while read -r session; do
        curl -s -X DELETE "${base_url}/session/${session}" >/dev/null 2>&1
      done
SCRIPT

# Run PHPUnit in the container directory that matches the host directory the
# command was started from, so test paths are relative to it. 'ddev exec' runs
# from the project root otherwise. pwd -P resolves symlinks in both directories,
# so a directory inside the project starts with the project root.
container_root=/var/www/html
dir="$container_root"
here=$(pwd -P)
approot=$(cd "$DDEV_APPROOT" && pwd -P)
case "$here/" in
  "$approot"/*) dir="$container_root${here#"$approot"}" ;;
esac

# Only override SIMPLETEST_DB when --db was specified; otherwise the container
# default applies.
cmd=(phpunit -c "$container_root/${DDEV_DOCROOT:+$DDEV_DOCROOT/}core" "${args[@]}")
[ -n "$DB" ] && cmd=(env "SIMPLETEST_DB=$SIMPLETEST_DB" "${cmd[@]}")
# --raw runs the command directly. Without it ddev joins the arguments with
# spaces and runs the result through a shell in the container, which splits
# them again and treats metacharacters as syntax: --filter 'testFoo|testBar'
# turns into a pipe.
ddev exec --raw --dir "$dir" -- "${cmd[@]}"
