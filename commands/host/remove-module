#!/usr/bin/env bash

#ddev-generated
## Description: Remove a contrib module added with add-module
## Usage: remove-module <module_name>
## Example: "ddev remove-module token"

set -e

. "$DDEV_APPROOT/.ddev/drupal-dev/command-helpers.sh"

if [ $# -eq 0 ]; then
  echo "Usage: ddev remove-module <module_name>"
  echo ""
  echo "Removes a contrib module: uninstalls via composer, removes the path"
  echo "repository, and deletes the cloned directory."
  echo ""
  echo "Example:"
  echo "  ddev remove-module token"
  exit 1
fi

MODULE_NAME="$1"

validate_module_name "$MODULE_NAME" || exit 1

cd "$DDEV_APPROOT"

MODULE_DIR=$(get_module_dir "$MODULE_NAME")

# Check that the module was actually added.
if [ ! -d "$MODULE_DIR" ] && ! ddev composer show "drupal/$MODULE_NAME" >/dev/null 2>&1; then
  echo "Error: drupal/$MODULE_NAME is not installed."
  exit 1
fi

# Check for uncommitted or untracked changes before proceeding.
if is_git_checkout "$MODULE_DIR" && [ -n "$(git -C "$MODULE_DIR" status --porcelain 2>/dev/null)" ]; then
  echo "Error: $MODULE_DIR has uncommitted or untracked changes."
  echo "Commit or stash your changes first, or delete the directory manually."
  exit 1
fi

# Remove the composer requirement.
echo "Removing drupal/$MODULE_NAME from composer..."
if ! ddev composer remove --no-interaction "drupal/$MODULE_NAME"; then
  echo "Error: Failed to remove drupal/$MODULE_NAME. Another package may depend on it."
  exit 1
fi

# Remove the path repository.
echo "Removing path repository..."
ddev composer config --unset repositories.$MODULE_NAME || true

# Delete the cloned directory. For a worktree, remember the main repo first
# so its stale worktree entry can be pruned after deletion.
if [ -d "$MODULE_DIR" ]; then
  GIT_COMMON_DIR=""
  if [ -f "$MODULE_DIR/.git" ]; then
    GIT_COMMON_DIR=$(git -C "$MODULE_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  fi
  echo "Deleting $MODULE_DIR..."
  rm -rf "$MODULE_DIR"
  if [ -n "$GIT_COMMON_DIR" ]; then
    git --git-dir="$GIT_COMMON_DIR" worktree prune 2>/dev/null || true
  fi
fi

echo ""
echo "Done! drupal/$MODULE_NAME has been removed."
